# Base image: Python 3.10 slim on Debian Bookworm
FROM python:3.10-slim-bookworm

# Set environment variable to suppress interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

WORKDIR /app

# --- 1. Install OS dependencies + ODBC Drivers (msodbcsql18) ---
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        curl gnupg apt-transport-https ca-certificates \
        build-essential \
        unixodbc-dev \
        gcc g++ \
        bash jq procps locales && \
    # Install Microsoft packages for ODBC Driver
    curl -sSL https://packages.microsoft.com/keys/microsoft.asc | gpg --dearmor > /etc/apt/trusted.gpg.d/microsoft.gpg && \
    echo "deb [arch=amd64] https://packages.microsoft.com/debian/12/prod bookworm main" > /etc/apt/sources.list.d/mssql-release.list && \
    apt-get update && \
    # Install the ODBC driver and SQL tools
    ACCEPT_EULA=Y apt-get install -y msodbcsql18 mssql-tools18 && \
    # Create symlinks for easy access
    ln -s /opt/mssql-tools18/bin/sqlcmd /usr/local/bin/sqlcmd && \
    ln -s /opt/mssql-tools18/bin/bcp /usr/local/bin/bcp && \
    # Cleanup to keep image size small
    apt-get clean && rm -rf /var/lib/apt/lists/*

# --- 2. Install Python requirements ---
COPY requirements.txt /app/requirements.txt
# Install pyodbc explicitly here alongside others for better dependency management
RUN pip install --upgrade pip && \
    pip install --no-cache-dir -r /app/requirements.txt && \
    pip install --no-cache-dir pyodbc

# --- 3. Copy application files into image with specific permissions ---
# Copy entrypoint scripts with execute permissions first
ADD --chown=root:root ["docker-entrypoint.sh", "/app/docker-entrypoint.sh"]
ADD --chown=root:root ["sqlcmd.sh", "/app/sqlcmd.sh"]

# 🟢 CRITICAL STEP: Copy the rest of the application files (Python code, Alembic structure, alembic.ini, etc.)
# This line MUST ensure that the 'alembic/versions' directory is included.
COPY . /app 

# --- 4. Critical Fix for Windows Line Endings ---
RUN if [ -f /app/sqlcmd.sh ]; then \
        sed -i 's/\r$//' /app/sqlcmd.sh; \
    fi && \
    if [ -f /app/docker-entrypoint.sh ]; then \
        sed -i 's/\r$//' /app/docker-entrypoint.sh; \
    fi

# Expose the application port
EXPOSE 8000

# Set the entrypoint to the shell script
ENTRYPOINT ["/app/docker-entrypoint.sh"]