# -------------------------------------------------------------------
# STAGE 1: Build the React Application
# Uses the 'builder' alias for the next stage to reference
# -------------------------------------------------------------------
FROM node:20-alpine AS builder

# Set the working directory
WORKDIR /app

# Copy dependency files only (package.json/lockfile)
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy the remaining application source code
COPY . .

# Run the build command (This step relies on the vite.config.js fix above)
RUN npm run build

# -------------------------------------------------------------------
# STAGE 2: Serve the Application with NGINX
# -------------------------------------------------------------------
FROM nginx:alpine

# Copy the built output from the 'builder' stage into the NGINX web root
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy your custom NGINX configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]

